# Playstation2 uses 128 bit access, which currently requires n32 ABI
CFLAGS+= -mabi=n32 -march=r5900 -fno-pic -msoft-float -mno-llsc
AFLAGS+= -mabi=n32 -march=r5900 -fno-pic -msoft-float -mno-llsc

# The EE FPU supports single precision only, including context save code.
COPTS.mips_fpu.c+= -msingle-float
AFLAGS.fp.S+= -msingle-float
LINKFORMAT+= -m elf32ltsmipn32

# Only PS2_IOP_BOOTSTRAP includes the IOP images (iop/ps2_iop_images.h,
# regenerated by iop/mkimages.sh).
CPPFLAGS+= -I${S}/arch/playstation2/iop
